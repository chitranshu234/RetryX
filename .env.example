# ============================================================================
#  Retryx — environment template
# ============================================================================
#  Copy to .env and edit. Every value here has a working default in
#  application.yml, so .env is only needed to change something.
#
#  docker-compose.yml does NOT read this file — it sets its own values inline so
#  that `docker compose up` works on a fresh clone with no setup. Use this when
#  running the backend outside Docker.
# ============================================================================

# ---- database --------------------------------------------------------------
RETRYX_DB_URL=jdbc:postgresql://localhost:5432/retryx
RETRYX_DB_USER=retryx
RETRYX_DB_PASSWORD=retryx
RETRYX_DB_POOL_SIZE=20

# ---- encryption at rest ----------------------------------------------------
# 32 raw bytes, base64. Generate with:
#     openssl rand -base64 32
#
# The default in application.yml is a PUBLIC key committed to this repository.
# With SPRING_PROFILES_ACTIVE=prod the application refuses to start while it is
# still in use — a deployment that fails to start is a ten-minute problem; one
# that silently signs webhooks with a published key is an incident.
RETRYX_ENCRYPTION_KEY=

# ---- delivery workers ------------------------------------------------------
RETRYX_WORKER_ENABLED=true
# Must be unique per process. Two workers sharing an id can each pass the
# other's lease check, which is the double send the lease exists to prevent.
RETRYX_WORKER_ID=
RETRYX_WORKER_POLL_MS=500
RETRYX_WORKER_BATCH_SIZE=25
RETRYX_WORKER_CONCURRENCY=16
# Must comfortably exceed connect + read timeout below, or a slow receiver
# outlives its own claim and the delivery is sent twice.
RETRYX_WORKER_LEASE_SECONDS=60

# ---- stale claim recovery --------------------------------------------------
RETRYX_REAPER_ENABLED=true
# Crash recovery time is bounded by lease-seconds + this interval.
RETRYX_REAPER_INTERVAL_MS=5000

# ---- retry policy ----------------------------------------------------------
RETRYX_MAX_ATTEMPTS=6
RETRYX_BASE_DELAY_SECONDS=2
RETRYX_BACKOFF_MULTIPLIER=2.0
RETRYX_MAX_DELAY_SECONDS=3600
# FULL | EQUAL | NONE. NONE is for tests and demos only — without jitter, a
# receiver coming back from an outage is hit by synchronised retry waves.
RETRYX_JITTER=EQUAL

# ---- outbound HTTP ---------------------------------------------------------
RETRYX_HTTP_CONNECT_TIMEOUT_MS=3000
RETRYX_HTTP_READ_TIMEOUT_MS=10000

# ---- SSRF protection -------------------------------------------------------
RETRYX_SSRF_ENABLED=true
RETRYX_REQUIRE_HTTPS=false
RETRYX_ALLOWED_PORTS=80,443,8080,9090,8443
# DEVELOPMENT ONLY. Every host listed here skips the private-address checks.
# Needed so the bundled receiver on localhost works. Leave empty in production;
# the prod profile forces it empty regardless.
RETRYX_SSRF_ALLOW_HOSTS=localhost,127.0.0.1,receiver

# ---- dashboard -------------------------------------------------------------
RETRYX_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- demo seed data --------------------------------------------------------
RETRYX_DEMO_ENABLED=true
RETRYX_DEMO_API_KEY=rtx_sk_demo_0000000000000000000000
RETRYX_DEMO_RECEIVER_URL=http://localhost:9090
RETRYX_DEMO_SIGNING_SECRET=whsec_demo_only_shared_secret_change_me

# ---- receiver (separate app) -----------------------------------------------
RECEIVER_PORT=9090
RECEIVER_SIGNING_SECRET=whsec_demo_only_shared_secret_change_me
# Raise to 0.2 for the load test figures quoted in the README.
RECEIVER_FAILURE_RATE=0.0
RECEIVER_LATENCY_MS=0
